VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping test"

# Collab2Us environment variables

# Secret key used to sign JWT sessions stored in HTTP-only cookies.
JWT_SECRET=

# Public server and client URL.
CLIENT_URL=http://localhost:8080
SERVER_URL=http://localhost:8080

# Server listening port.
PORT=8080

# Database connection settings.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=Collab2Us
PGSSLMODE=disable

# Automatically apply the database schema from server/sql/schema.sql at startup.
DB_AUTO_MIGRATE=true

# OAuth token settings.
ENABLE_SAVE_TOKEN_GOOGLE=true
ENABLE_SAVE_TOKEN_MIRO=true
ENABLE_SAVE_TOKEN_TRELLO=true
ENABLE_EXPOSE_TOKENS=true

# Google OAuth credentials and callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/redirect/google

# Miro OAuth credentials and callback URL.
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
MIRO_REDIRECT_URI=http://localhost:8080/auth/redirect/miro

# Trello OAuth credentials and callback URL.
TRELLO_KEY=
TRELLO_SECRET=
TRELLO_REDIRECT_URI=http://localhost:8080/auth/redirect/trello